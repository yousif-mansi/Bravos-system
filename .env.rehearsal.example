# Labeled loopback built-artifact rehearsal only. This file is not loaded automatically.
# Use real operator-supplied values and keep secrets out of the repository.
NODE_ENV=production
DATABASE_URL=postgres://bravos:replace-me@127.0.0.1:5432/bravos
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://127.0.0.1:3010
BRAVOS_INTERNAL_ORIGIN=http://127.0.0.1:5173
BRAVOS_PUBLIC_ORIGIN=http://127.0.0.1:3000
BRAVOS_OWNER_RECOVERY_ADAPTER=operator-file
# Both directories must be absolute, disjoint from the repository and each other; recovery is service-account-only.
BRAVOS_OWNER_RECOVERY_OUTBOX_DIR=C:/BravosPrivate/recovery
BRAVOS_PRODUCT_MEDIA_DIR=C:/BravosPrivate/media
BRAVOS_PUBLIC_ORDERING_ENABLED=false
BRAVOS_REHEARSAL_LOOPBACK_HTTP_ACK=true
BRAVOS_LOOPBACK_REHEARSAL=true
BRAVOS_SECURE_COOKIES=false
