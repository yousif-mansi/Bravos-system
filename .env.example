# Copy values into a gitignored .local/dev.env via `pnpm setup:local`.
# Do not put production secrets here.

NODE_ENV=development
DATABASE_URL=postgres://bravos:bravos-test@127.0.0.1:54329/bravos
BETTER_AUTH_SECRET=replace-with-a-long-local-secret
BETTER_AUTH_URL=http://127.0.0.1:3010
BRAVOS_INTERNAL_ORIGIN=http://127.0.0.1:5173
BRAVOS_PUBLIC_ORIGIN=http://127.0.0.1:3000
BRAVOS_OWNER_RECOVERY_ADAPTER=local-outbox
BRAVOS_OWNER_RECOVERY_OUTBOX_DIR=.local/owner-recovery-outbox
BRAVOS_SECURE_COOKIES=false

# Optional labeled local setup credentials. If omitted, setup generates disposable values
# and writes them to .local/demo-credentials.txt.
# BRAVOS_SETUP_OWNER_LOGIN=owner
# BRAVOS_SETUP_OWNER_PASSWORD=
# BRAVOS_SETUP_OWNER_DISPLAY_NAME=مالك برافوس
# BRAVOS_SETUP_DEMO_CASHIER_LOGIN=cashier
# BRAVOS_SETUP_DEMO_CASHIER_PASSWORD=

# Staff POS receipt printing (Vite env for apps/internal). Restart or rebuild the
# staff app after changing these. They are not API secrets and are not read by the server.
# Example public branch contact shown on the Arabic retail receipt.
VITE_POS_RECEIPT_PHONE=01017412287
# Thermal paper width in millimetres. Browser output is 58 mm portrait. A shipped value of 80 is accepted and treated as 58.
VITE_POS_RECEIPT_PAPER_WIDTH=58
