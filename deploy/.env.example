# Copy to repository root .env on the VPS. Restrict it to the operator account.
# Hostnames must have DNS records pointing at this VPS before Caddy requests TLS.
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgres://bravos:replace-with-url-encoded-password@db:5432/bravos
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=https://staff.example.com
BRAVOS_INTERNAL_ORIGIN=https://staff.example.com
BRAVOS_PUBLIC_ORIGIN=https://shop.example.com
BRAVOS_PUBLIC_ORDERING_ENABLED=false
BRAVOS_OWNER_RECOVERY_ADAPTER=operator-file
BRAVOS_DATA_DIR=/srv/bravos
BRAVOS_EDGE_NETWORK=edge
# Days of backups backup.sh keeps under $BRAVOS_DATA_DIR/backups (default 30; the newest is always kept).
# BRAVOS_BACKUP_RETENTION_DAYS=30
# Optional public receipt configuration is baked into the staff image at build.
# VITE_POS_RECEIPT_PHONE=01000000000
# VITE_POS_RECEIPT_PAPER_WIDTH=80
